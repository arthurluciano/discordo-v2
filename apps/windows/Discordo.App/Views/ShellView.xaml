<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Discordo.App.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Discordo.App.ViewModels">

    <Grid Padding="8,0,8,8" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <!-- Servers -->
        <Border Style="{StaticResource GlassPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="GuildList" ItemsSource="{x:Bind ViewModel.Guilds}" SelectionChanged="OnGuildSelected"
                          Padding="0,8" AutomationProperties.Name="Servidores">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuildItem">
                            <Grid Width="44" Height="44" Margin="-4,4"
                                  ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                <Ellipse Fill="{ThemeResource GlassAccent}" />
                                <TextBlock Text="{x:Bind Initial, Mode=OneWay}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,12" HorizontalAlignment="Center">
                    <Button x:Name="AddButton" Width="44" Height="44" CornerRadius="22" Padding="0" Content="+" FontSize="20"
                            ToolTipService.ToolTip="Criar ou entrar em um servidor" AutomationProperties.Name="Criar ou entrar em um servidor">
                        <Button.Flyout>
                            <Flyout x:Name="AddFlyout">
                                <StackPanel Spacing="8" Width="260">
                                    <TextBlock Text="Criar um servidor" FontWeight="SemiBold" />
                                    <TextBox x:Name="NewGuildName" PlaceholderText="Nome do servidor" MaxLength="100" />
                                    <Button Content="Criar" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnCreateGuild" />
                                    <TextBlock Text="Entrar com um convite" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBox x:Name="InviteCode" PlaceholderText="Código do convite" MaxLength="32" />
                                    <Button Content="Entrar" HorizontalAlignment="Stretch" Click="OnJoinGuild" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Width="44" Height="44" CornerRadius="22" Padding="0" Click="OnLogout"
                            ToolTipService.ToolTip="Sair da conta" AutomationProperties.Name="Sair da conta">
                        <FontIcon Glyph="&#xF3B1;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Channels -->
        <Border Grid.Column="1" Style="{StaticResource GlassPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.GuildName, Mode=OneWay}" Style="{StaticResource PanelTitle}" Margin="16,16,16,8" />
                <ListView x:Name="ChannelList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Channels}" SelectionChanged="OnChannelSelected"
                          AutomationProperties.Name="Canais">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChannelItem">
                            <StackPanel Padding="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Glyph}" Opacity="0.6" Width="20" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind InCall, Mode=OneWay}" Visibility="{x:Bind InCallVisibility, Mode=OneWay}"
                                           Margin="28,2,0,0" FontSize="12" Opacity="0.75" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Margin="12" Spacing="8">
                    <Border x:Name="CallBar" Style="{StaticResource GlassPanelRaised}" Padding="12" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.CallTitle, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnToggleMute" ToolTipService.ToolTip="Ligar/desligar o microfone" AutomationProperties.Name="Ligar ou desligar o microfone">
                                    <FontIcon Glyph="&#xE720;" FontSize="16" />
                                </Button>
                                <Button Click="OnToggleDeafen" ToolTipService.ToolTip="Ligar/desligar o som" AutomationProperties.Name="Ligar ou desligar o som">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="16" />
                                </Button>
                                <Button Click="OnLeaveCall" ToolTipService.ToolTip="Sair da chamada" AutomationProperties.Name="Sair da chamada">
                                    <FontIcon Glyph="&#xE778;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="InviteButton" Content="Convidar pessoas" HorizontalAlignment="Stretch" Click="OnInvite" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat -->
        <Border Grid.Column="2" Style="{StaticResource GlassPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ChannelTitle, Mode=OneWay}" Style="{StaticResource PanelTitle}" Margin="20,16,20,8" />
                <ListView x:Name="MessageList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Messages}" SelectionMode="None"
                          Padding="8,0" AutomationProperties.Name="Mensagens">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageItem">
                            <StackPanel Padding="0,6" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Author}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Time}" Opacity="0.6" FontSize="12" VerticalAlignment="Bottom" />
                                    <TextBlock Text="{x:Bind EditedMark, Mode=OneWay}" Opacity="0.6" FontSize="12" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Content, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Margin="20,4" Opacity="0.8" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <Border Grid.Row="3" Style="{StaticResource GlassPanelRaised}" Margin="12" Padding="4">
                    <TextBox x:Name="Composer" PlaceholderText="Escreva uma mensagem" MaxLength="4000" BorderThickness="0"
                             Background="Transparent" KeyDown="OnComposerKeyDown" AutomationProperties.Name="Mensagem" />
                </Border>
            </Grid>
        </Border>

        <!-- Members -->
        <Border Grid.Column="3" Style="{StaticResource GlassPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Membros" Style="{StaticResource PanelTitle}" Margin="16,16,16,8" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Members}" SelectionMode="None" AutomationProperties.Name="Membros">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemberItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" Opacity="{x:Bind Opacity, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}">
                                <Ellipse Width="10" Height="10" Fill="{ThemeResource GlassOnline}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
