<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Discordo.App</RootNamespace>
    <AssemblyName>Discordo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: a plain .exe, no MSIX or certificate needed to run it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Discordo.Core\Discordo.Core.csproj" />
  </ItemGroup>

  <!-- The native media engine (Rust). Needs the Rust toolchain and CMake (for libopus) on the build machine. -->
  <PropertyGroup>
    <MediaCoreDir>$(MSBuildThisFileDirectory)..\..\..\crates\media-core\</MediaCoreDir>
  </PropertyGroup>
  <Target Name="BuildMediaCore" BeforeTargets="BeforeBuild">
    <Exec Command="cargo build --release --manifest-path &quot;$(MediaCoreDir)Cargo.toml&quot;" />
  </Target>
  <ItemGroup>
    <Content Include="$(MediaCoreDir)target\release\media_core.dll" Link="media_core.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
